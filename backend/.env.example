# Google OAuth2 Credentials — optional/unused by default (Calendar & Sheets
# use the service account below; email uses the Gmail App Password further
# down instead). Only needed if you switch Calendar/Sheets auth to OAuth2.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2callback
GOOGLE_REFRESH_TOKEN=1//your-google-refresh-token

# Google Service Account (used for writing bookings to Google Sheets and, if
# GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL below is unset, also Calendar). Share
# the target Sheet with this account's email, Editor access.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional: a SEPARATE service account used only for Calendar, so it can be
# pointed at the owner's own calendar independently of the account above.
# Share the target Calendar with this account's email, "Make changes to
# events" access. Leave unset to keep using the account above for Calendar.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=

# Gmail App Password (free) — sends the owner-notification email when a
# booking is confirmed. Generate at myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the sending account). Sends from
# GMAIL_SENDER_EMAIL (defaults to OWNER_EMAIL if unset) to OWNER_EMAIL.
GMAIL_SENDER_EMAIL=owner@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Homestay Owner Credentials & Config
OWNER_EMAIL=owner@gmail.com
OWNER_PHONE=+919840123456
OWNER_CALENDAR_ID=primary

# Google Sheets Database
SHEET_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini API (used by the website chatbot)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Server Port
PORT=5000

# Set to "production" when deploying. In production, an unset CORS_ORIGINS
# blocks all cross-origin requests by default (safe); in development it
# allows all origins for convenience.
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS. Required in
# production — set this to your deployed frontend's exact URL(s).
CORS_ORIGINS=http://localhost:8080

# Optional. Only needed on serverless hosting (e.g. Vercel), where each
# request can hit a different/cold instance, so the default in-memory rate
# limiter can't share counts across them. Point this at a Redis database
# (e.g. a free Upstash instance's connection string) to make rate limiting
# work correctly there. Leave unset for a normal long-running server (local
# dev, Render, Railway, etc.) — rate limiting falls back to in-memory.
REDIS_URL=

# Daily booking limits (reset at midnight IST; optional — these are the
# defaults). Counted from the Google Sheet, so they hold on serverless too.
# MAX_BOOKINGS_PER_DAY is a site-wide circuit breaker: once reached, every
# further booking that day is told "all rooms are fully booked", whatever
# dates are requested. MAX_BOOKINGS_PER_PHONE_PER_DAY caps one mobile number.
MAX_BOOKINGS_PER_DAY=30
MAX_BOOKINGS_PER_PHONE_PER_DAY=3
