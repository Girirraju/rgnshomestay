# Base URL of the backend API (Express server in ../backend).
# Local dev: http://localhost:5000/api
# Deployed on Vercel: "/api" — relative, so calls stay same-origin and are
# proxied to the backend via BACKEND_URL below (see vite.config.ts).
VITE_API_URL=http://localhost:5000/api

# Build-time only, used on Vercel: the deployed backend's base URL, e.g.
# https://your-backend.vercel.app (no trailing /api). When set, /api/* on the
# frontend is rewritten to it. Leave unset for local dev.
# BACKEND_URL=
