# Base URL of the backend API (Express server in ../backend).
# Local dev: http://localhost:5000/api
# Deployed on Vercel (see rgn-homestyle-retreat-main/vercel.json, which
# proxies /api/* to the backend project): just "/api" — relative, so it
# stays same-origin through that rewrite instead of a hardcoded backend URL.
VITE_API_URL=http://localhost:5000/api
